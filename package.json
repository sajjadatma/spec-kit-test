{
  "name": "industrial-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "infra:up": "tsx scripts/infra.ts up",
    "infra:stop": "tsx scripts/infra.ts stop",
    "db:migrate": "prisma migrate dev",
    "db:seed:dev": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "contracts:check": "tsx scripts/contracts.ts",
    "test:unit": "vitest run",
    "test:integration": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:concurrency": "jest --runInBand tests/concurrency",
    "test:load": "tsx scripts/not-implemented.ts test:load",
    "test:recovery": "tsx scripts/not-implemented.ts test:recovery",
    "validate:images": "tsx scripts/not-implemented.ts validate:images",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@prisma/client": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
