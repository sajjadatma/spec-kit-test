# Development-only defaults. Copy this file to .env and replace values before deployment.
NODE_ENV=development
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/industrial_dashboard
DIRECT_URL=postgresql://dashboard:dashboard@localhost:5432/industrial_dashboard
# Set POSTGRES_PORT=5433 only when another local PostgreSQL service already owns port 5432.
POSTGRES_PORT=5432
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-32-character-local-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-local-secret
CSRF_SECRET=replace-with-a-third-32-character-local-secret
TOKEN_HASH_SECRET=replace-with-a-fourth-32-character-local-secret
# Set only for the one-time, operator-run `pnpm admin:bootstrap` command. Never commit real values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_LOCALE=en
MAIL_TRANSPORT=local
MAIL_OUTBOX_ENCRYPTION_KEY=replace-with-a-32-byte-mail-outbox-key
MAILPIT_URL=http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@industrial-dashboard.local
# Set SMTP_SECURE=true and SMTP_REQUIRE_TLS=true for a TLS SMTP provider.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./private-media
IMAGE_PROVIDER=fake
IMAGE_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
